<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FluentSpecification</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>

    <PackageId>IcodeNet.FluentSpecification</PackageId>
    <AssemblyName>FluentSpecification</AssemblyName>
    <Version>1.1.1</Version>
    <Authors>Icode.net Ltd</Authors>
    <Company>Icode.net Ltd</Company>
    <Description>A lightweight implementation of the Specification pattern. Express business rules as reusable objects and combine them with And, Or and Not.</Description>
    <Copyright>Copyright Icode.net Ltd 2015-2026</Copyright>
    <PackageTags>specification;specification-pattern;business-rules;linq;ddd;fluent</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/IcodeNet/FluentSpecification</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IcodeNet/FluentSpecification.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.*" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\docs\images\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
